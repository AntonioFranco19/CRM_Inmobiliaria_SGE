<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CRM_Inmobiliaria_SGE.Views.FacturacionView">

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <!-- Cabecera -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,15">
            <TextBlock Grid.Column="0" Text="Facturación y Finanzas" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="+ Emitir Nueva Factura" Click="OnNuevaFacturaClick" Background="#16A34A" Foreground="White" FontWeight="Bold"/>
        </Grid>

        <!-- Listado de Facturas -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
            <ListBox x:Name="ListaFacturas">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="110,2*,*,*,*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Factura.NumeroFactura}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Factura.FechaEmision, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Factura.Concepto}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DestinatarioTexto}" FontSize="12" Foreground="#475569"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Factura.BaseImponible, StringFormat='Base: {0:N2} €'}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Factura.CuotaIva, StringFormat='IVA (21%): {0:N2} €'}" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Factura.Total, StringFormat='Total: {0:N2} €'}" FontWeight="Bold" FontSize="15" Foreground="#2563EB" VerticalAlignment="Center"/>
                                <Button Grid.Column="5" Content="Eliminar" Click="OnEliminarFacturaClick" Background="#EF4444" Foreground="White" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Formulario de Emisión con cálculo de IVA automático -->
        <Border Grid.Row="2" Background="#FFB7E0F8" Margin="0,15,0,0" Padding="15" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Emitir Factura" FontWeight="Bold" FontSize="16"/>

                <Grid ColumnDefinitions="*,2*,2*,*" RowDefinitions="Auto,Auto" Margin="0,5,0,0">
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Nº Factura:" FontSize="12"/>
                        <TextBox x:Name="TxtNumeroFactura" Watermark="2026-F001"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock Text="Concepto:" FontSize="12"/>
                        <TextBox x:Name="TxtConcepto" Watermark="Honorarios intermediación venta..."/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,10">
                        <TextBlock Text="Cliente Asignado:" FontSize="12"/>
                        <ComboBox x:Name="CmbClientesFactura" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,10">
                        <TextBlock Text="Base Imponible (€):" FontSize="12"/>
                        <TextBox x:Name="TxtBaseImponible" Watermark="1000.00" KeyUp="OnBaseImponibleKeyUp"/>
                    </StackPanel>

                    <!-- Fila de totales calculados en tiempo real -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#F8FAFC" Padding="10" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="25" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtResumenBase" Text="Base: 0,00 €" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtResumenIva" Text="IVA (21%): 0,00 €" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtResumenTotal" Text="Total a Facturar: 0,00 €" FontWeight="Bold" Foreground="#16A34A" FontSize="15"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="1" Grid.Column="3" Content="Guardar Factura" Click="OnGuardarFacturaClick" 
                            Background="#2563EB" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" Height="36"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>