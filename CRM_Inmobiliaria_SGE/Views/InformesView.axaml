<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CRM_Inmobiliaria_SGE.Views.InformesView">

    <Grid RowDefinitions="Auto,*" Margin="10">
        <!-- Cabecera -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,15">
            <TextBlock Grid.Column="0" Text="📊 Panel de Informes y Analítica" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="🔄 Actualizar Datos" Click="OnActualizarInformesClick" Background="#2563EB" Foreground="White" FontWeight="Bold"/>
        </Grid>

        <!-- Tres tarjetas de informes -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,5,0,0">
            
            <!-- Informe 1: Ventas y Comisiones por Mes -->
            <Border Grid.Column="0" Background="White" Margin="0,0,10,0" Padding="15" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
                        <TextBlock Text="1. Ventas por Mes" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Volumen facturado y honorarios" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>

                    <ListBox x:Name="ListaVentasMes" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Periodo}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding OperacionesCount, StringFormat='{}{0} operaciones'}" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalHonorarios, StringFormat='{}{0:N0} €'}" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Informe 2: Tipo de Inmueble Estrella -->
            <Border Grid.Column="1" Background="White" Margin="5,0,5,0" Padding="15" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
                        <TextBlock Text="2. Producto Estrella" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Rendimiento por tipo de inmueble" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>

                    <ListBox x:Name="ListaTiposEstrella" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding TipoNombre}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding UnidadesVendidas, StringFormat='{}{0} ventas cerradas'}" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding VolumenEuros, StringFormat='{}{0:N0} €'}" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Informe 3: Mejores Clientes -->
            <Border Grid.Column="2" Background="White" Margin="10,0,0,0" Padding="15" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
                        <TextBlock Text="3. Top Clientes" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Mayor volumen adquirido o visitas" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>

                    <ListBox x:Name="ListaTopClientes" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding NombreCompleto}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding VisitasRealizadas, StringFormat='{}{0} visitas efectuadas'}" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ImporteTotalInvertido, StringFormat='{}{0:N0} €'}" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>