<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CRM_Inmobiliaria_SGE.Views.MatchingView">

    <Grid RowDefinitions="Auto,*" Margin="10">
        
        <!-- Panel Superior: Selector de Cliente y Demandas -->
        <Border Grid.Row="0" Background="#FFB7E0F8" Padding="15" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,15">
            <StackPanel Spacing="10">
                <TextBlock Text="🎯 Motor de Cruce / Matching Inmobiliario" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Selecciona un cliente comprador para cruzar sus preferencias con los inmuebles disponibles en cartera." FontSize="13" Foreground="#64748B"/>

                <Grid ColumnDefinitions="2*,Auto" Margin="0,5,0,0">
                    <ComboBox x:Name="CmbClientesMatching" HorizontalAlignment="Stretch" SelectionChanged="OnClienteSeleccionadoParaMatchingChanged"/>
                    <Button Grid.Column="1" Content="Recalcular Cruce" Click="OnRecalcularClick" Margin="10,0,0,0" Background="#2563EB" Foreground="White" FontWeight="Bold"/>
                </Grid>

                <!-- Resumen de criterios del cliente -->
                <Border Background="#F1F5F9" Padding="10" CornerRadius="4" Margin="0,5,0,0">
                    <TextBlock x:Name="TxtCriteriosCliente" Text="Selecciona un cliente para ver sus criterios de búsqueda." Foreground="#334155" FontWeight="Medium"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Resultados del Matching -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" x:Name="TxtTotalCoincidencias" Text="Inmuebles Coincidentes: 0" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                <ListBox x:Name="ListaResultadosMatching">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="100,2*,*,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Referencia}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Ciudad}" FontSize="12" Foreground="#64748B"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Tipo}" FontSize="12" Foreground="#475569"/>
                                        <TextBlock Text="{Binding Habitaciones, StringFormat='{}{0} hab.'}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Precio, StringFormat='{}{0:N0} €'}" FontWeight="Bold" FontSize="16" Foreground="#16A34A" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Content="Agendar Visita Directa" Click="OnAgendarVisitaDirectaClick" Background="#2563EB" Foreground="White" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

    </Grid>
</UserControl>