<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CRM_Inmobiliaria_SGE.Views.ProveedoresView">

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <!-- Cabecera -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,15">
            <TextBlock Grid.Column="0" Text="Gestión de Proveedores y Servicios" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtBuscarProveedor" Grid.Column="1" Margin="20,0,10,0" Watermark="Buscar proveedor por CIF, nombre o sector..." KeyUp="OnBuscarKeyUp"/>
            <Button Grid.Column="2" Content="+ Nuevo Proveedor" Click="OnNuevoProveedorClick" Background="#16A34A" Foreground="White" FontWeight="Bold"/>
        </Grid>

        <!-- Listado -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
            <ListBox x:Name="ListaProveedores" SelectionChanged="OnProveedorSeleccionadoChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="110,2*,*,*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Cif}" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NombreComercial}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Sector}" FontWeight="Medium" Foreground="#2563EB" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Telefono}" VerticalAlignment="Center"/>
                                <Button Grid.Column="4" Content="Eliminar" Click="OnEliminarProveedorClick" Background="#EF4444" Foreground="White" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Formulario Alta / Edición -->
        <Border Grid.Row="2" Background="#FFB7E0F8" Margin="0,15,0,0" Padding="15" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1">
            <StackPanel Spacing="10">
                <TextBlock x:Name="TxtTituloFormulario" Text="Añadir / Editar Proveedor" FontWeight="Bold" FontSize="16"/>

                <Grid ColumnDefinitions="*,2*,*,*,Auto" Margin="0,5,0,0">
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="CIF / NIF:" FontSize="12"/>
                        <TextBox x:Name="TxtCif" Watermark="B12345678"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Razón Social / Nombre:" FontSize="12"/>
                        <TextBox x:Name="TxtNombreComercial" Watermark="Notaría Central / Fotógrafo Pro..."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Sector:" FontSize="12"/>
                        <TextBox x:Name="TxtSector" Watermark="Notaría, Tasador, Portal..."/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Teléfono:" FontSize="12"/>
                        <TextBox x:Name="TxtTelefono" Watermark="968000000"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                        <Button Content="Limpiar" Click="OnLimpiarClick" Background="#C92727" Foreground="White"/>
                        <Button Content="Guardar" Click="OnGuardarProveedorClick" Background="#2563EB" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>