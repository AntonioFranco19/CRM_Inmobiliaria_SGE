<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CRM_Inmobiliaria_SGE.Views.UsuariosView">

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <!-- Cabecera -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,15">
            <TextBlock Grid.Column="0" Text="⚙️ Gestión de Usuarios y Permisos" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="+ Nuevo Usuario" Click="OnNuevoUsuarioClick" Background="#16A34A" Foreground="White" FontWeight="Bold"/>
        </Grid>

        <!-- Listado de Usuarios -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
            <ListBox x:Name="ListaUsuarios" SelectionChanged="OnUsuarioSeleccionadoChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="140,2*,*,100,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Username}" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding NombreCompleto}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Rol}" FontWeight="Medium" Foreground="#2563EB" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Activo, StringFormat='Activo: {0}'}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Button Grid.Column="4" Content="Eliminar" Click="OnEliminarUsuarioClick" Background="#EF4444" Foreground="White" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Formulario Alta / Modificación -->
        <Border Grid.Row="2" Background="#FFB7E0F8" Margin="0,15,0,0" Padding="15" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1">
            <StackPanel Spacing="10">
                <TextBlock x:Name="TxtTituloFormulario" Text="Añadir / Editar Usuario" FontWeight="Bold" FontSize="16"/>

                <Grid ColumnDefinitions="*,2*,*,*,Auto" Margin="0,5,0,0">
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Usuario (Login):" FontSize="12"/>
                        <TextBox x:Name="TxtUsername" Watermark="agente2"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Nombre Completo:" FontSize="12"/>
                        <TextBox x:Name="TxtNombreCompleto" Watermark="Nombre y apellidos..."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Contraseña:" FontSize="12"/>
                        <TextBox x:Name="TxtPassword" PasswordChar="•" Watermark="Clave..."/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Rol Asignado:" FontSize="12"/>
                        <ComboBox x:Name="CmbRol" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                        <CheckBox x:Name="ChkActivo" Content="Activo" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Limpiar" Click="OnLimpiarClick" Background="#C92727" Foreground="White"/>
                        <Button Content="Guardar" Click="OnGuardarUsuarioClick" Background="#2563EB" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>